
class Student {

    // Maximum permitted marks per subject
    public static final int MAX_MARKS = 100;

    // Static variable to count students
    private static int studentCount = 0;

    // Private data members
    private String usn;
    private String name;
    private int marks1, marks2, marks3;

    // Constructor
    Student(String usn, String name,
            int marks1, int marks2, int marks3) {

        if (!validateMarks(marks1, marks2, marks3)) {
            throw new IllegalArgumentException(
                "Marks must be between 0 and 100"
            );
        }

        this.usn = usn;
        this.name = name;
        this.marks1 = marks1;
        this.marks2 = marks2;
        this.marks3 = marks3;

        studentCount++;
    }

    // Validation method
    private boolean validateMarks(int m1, int m2, int m3) {
        return m1 >= 0 && m1 <= MAX_MARKS &&
               m2 >= 0 && m2 <= MAX_MARKS &&
               m3 >= 0 && m3 <= MAX_MARKS;
    }

    // Getter methods
    public String getUSN() {
        return usn;
    }

    public String getName() {
        return name;
    }

    public int getMarks1() {
        return marks1;
    }

    public int getMarks2() {
        return marks2;
    }

    public int getMarks3() {
        return marks3;
    }

    // Calculate total
    public int calculateTotal() {
        return marks1 + marks2 + marks3;
    }

    // Calculate average
    public double calculateAverage() {
        return calculateTotal() / 3.0;
    }

    // Overloaded display method - basic details
    public void display() {
        System.out.println("\n--- STUDENT DETAILS ---");
        System.out.println("USN: " + usn);
        System.out.println("Name: " + name);
    }

    // Overloaded display method - result details
    public void display(boolean showResult) {
        if (showResult) {
            System.out.println("\n--- STUDENT RESULT ---");
            System.out.println("Marks 1: " + marks1);
            System.out.println("Marks 2: " + marks2);
            System.out.println("Marks 3: " + marks3);
            System.out.println("Total: " + calculateTotal());
            System.out.println("Average: " + calculateAverage());
        }
    }

    // Return a new object containing result summary
    public StudentResult getResultSummary() {
        return new StudentResult(
            usn, name, calculateTotal(), calculateAverage()
        );
    }

    // Static method to get student count
    public static int getStudentCount() {
        return studentCount;
    }
}

// Class to store result summary
class StudentResult {

    private String usn;
    private String name;
    private int total;
    private double average;

    StudentResult(String usn, String name,
                  int total, double average) {
        this.usn = usn;
        this.name = name;
        this.total = total;
        this.average = average;
    }

    public void displaySummary() {
        System.out.println("\n--- RESULT SUMMARY ---");
        System.out.println("USN: " + usn);
        System.out.println("Name: " + name);
        System.out.println("Total Marks: " + total);
        System.out.println("Average: " + average);
    }
}

// Main class
public class Main {

    public static void main(String[] args) {

        // Create first student
        Student s1 = new Student(
            "1AB23CS001", "Rahul", 85, 90, 95
        );

        // Create second student
        Student s2 = new Student(
            "1AB23CS002", "Arun", 75, 80, 85
        );

        // Display basic details
        s1.display();
        s2.display();

        // Display results
        s1.display(true);
        s2.display(true);

        // Create result summary objects
        StudentResult r1 = s1.getResultSummary();
        StudentResult r2 = s2.getResultSummary();

        // Display summaries
        r1.displaySummary();
        r2.displaySummary();

        // Display total number of students
        System.out.println("\nTotal Students Created: "
                           + Student.getStudentCount());
    }
}
