
class Complex {

    int real;
    int imaginary;

    // Constructor
    Complex(int real, int imaginary) {
        this.real = real;
        this.imaginary = imaginary;
    }

    // Addition of two complex numbers
    public Complex add(Complex c) {
        int r = this.real + c.real;
        int i = this.imaginary + c.imaginary;

        return new Complex(r, i);
    }

    // Multiplication of two complex numbers
    public Complex multiply(Complex c) {
        int r = (this.real * c.real) -
                (this.imaginary * c.imaginary);

        int i = (this.real * c.imaginary) +
                (this.imaginary * c.real);

        return new Complex(r, i);
    }

    // Compare magnitudes of two complex numbers
    public void compareMagnitude(Complex c) {
        double m1 = Math.sqrt(real * real +
                              imaginary * imaginary);

        double m2 = Math.sqrt(c.real * c.real +
                              c.imaginary * c.imaginary);

        if (m1 > m2) {
            System.out.println("First complex number has greater magnitude");
        } else if (m1 < m2) {
            System.out.println("Second complex number has greater magnitude");
        } else {
            System.out.println("Both complex numbers have equal magnitude");
        }
    }

    // Copy method returns a new object
    public Complex copy() {
        return new Complex(this.real, this.imaginary);
    }

    // Display complex number
    public void display() {
        if (imaginary >= 0) {
            System.out.println(real + " + " + imaginary + "i");
        } else {
            System.out.println(real + " - " + (-imaginary) + "i");
        }
    }

    // Main method
    public static void main(String[] args) {

        Complex c1 = new Complex(4, 3);
        Complex c2 = new Complex(2, 5);

        System.out.print("First Complex Number: ");
        c1.display();

        System.out.print("Second Complex Number: ");
        c2.display();

        // Addition
        Complex sum = c1.add(c2);
        System.out.print("Addition: ");
        sum.display();

        // Multiplication
        Complex product = c1.multiply(c2);
        System.out.print("Multiplication: ");
        product.display();

        // Compare magnitude
        System.out.println("Magnitude Comparison:");
        c1.compareMagnitude(c2);

        // Copy object
        Complex c3 = c1.copy();

        System.out.print("Copied Object: ");
        c3.display();

        // Modify original object
        c1.real = 10;
        c1.imaginary = 20;

        System.out.print("Modified Original Object: ");
        c1.display();

        System.out.print("Copied Object After Modification: ");
        c3.display();
    }
}
